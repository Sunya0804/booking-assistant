        <item name="colorError">#FF8FA3</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Booking.Mono" parent="Theme.Booking.Base">
        <item name="isLightTheme">true</item>
        <item name="android:colorBackground">#FAFAFA</item>
        <item name="colorPrimary">#18181B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F4F4F5</item>
        <item name="colorOnPrimaryContainer">#18181B</item>
        <item name="colorSecondaryContainer">#F4F4F5</item>
        <item name="colorOnSecondaryContainer">#18181B</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#09090B</item>
        <item name="colorOnSurfaceVariant">#5F5F67</item>
        <item name="colorSurfaceVariant">#F4F4F5</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
