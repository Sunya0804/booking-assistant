        <item name="colorError">#DC2626</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Manifest default, shown until a screen applies the chosen theme. -->
    <style name="Theme.BookingAssistant" parent="Theme.Booking.Light" />
</resources>
